<!DOCTYPE html>
<html>
<head>
    <title>AI Chat</title>
    <style>
        body { font-family: Arial; max-width: 600px; margin: auto; }
        #chat { border: 1px solid #ccc; height: 400px; overflow-y: auto; padding: 10px; }
        .msg { margin: 5px 0; }
        .me { color: blue; }
        .ai { color: green; }
    </style>
</head>
<body>

<h2>💬 WebSocket Chat</h2>

<div id="chat"></div>

<input id="msg" placeholder="Type message..." />
<button onclick="send()">Send</button>

<script>
const ws = new WebSocket("ws://localhost:8000/ws/chat?token=dev");

const chat = document.getElementById("chat");

ws.onmessage = (event) => {
    const data = JSON.parse(event.data);

    if (data.event === "message:stream") {
        append("ai", data.data.chunk);
    }

    if (data.event === "message:receive") {
        append("ai", "\n"); // new line after full message
    }
};

function append(sender, text) {
    const div = document.createElement("div");
    div.className = "msg " + sender;
    div.innerText = sender + ": " + text;
    chat.appendChild(div);
    cha
t.scrollTop = chat.scrollHeight;
}

function send() {
    const input = document.getElementById("msg");
    const text = input.value;

    append("me", text);

    ws.send(JSON.stringify({
        event: "message:send",
        data: {
            recipient_id: "ai",
            message: text,
            message_type: "text"
        }
    }));

    input.value = "";
}
</script>

</body>
</html>
